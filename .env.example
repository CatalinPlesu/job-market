# LLM API Configuration (for data structuring)
ENDPOINT=https://your-llm-api-endpoint.com
LLM_API_KEY=your-api-key-here
MODEL=your-model-name

# Frontend Git Operations (for automated deployment)
# Remote URL for the frontend git repository (e.g., GitHub Pages)
# Example SSH: git@github.com:username/frontend-repo.git
# Example HTTPS: https://github.com/username/frontend-repo.git
FRONTEND_GIT_REMOTE_URL=

# Branch to push to (default: main)
FRONTEND_GIT_BRANCH=main

# Use fresh repo approach to keep size small (default: true)
# - true: Removes .git, reinitializes, and force pushes (smaller repo)
# - false: Incremental commits (preserves history)
FRONTEND_GIT_FRESH_APPROACH=true

# Debug Settings (for testing)
# Run Stage 3 (daily workflow with LLM + deployment) immediately instead of waiting for 00:00
# Set to true to test the complete workflow right now
DEBUG_RUN_STAGE3_NOW=false

# Skip scraping stages (1 & 2) and jump directly to LLM processing + deployment
# Useful when you already have scraped data and want to test LLM + deployment only
# When true, scheduler will only run Stage 3 (LLM processing + deployment)
DEBUG_SKIP_SCRAPING=false
